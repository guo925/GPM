<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.gjx.gpms.system.mapper.UserMapper">

    <!--
        根据用户名查询用户
    -->
    <select id="selectByUsername"
            resultType="com.gjx.gpms.system.entity.User">

        SELECT *
        FROM sys_user
        WHERE username = #{username}
          AND is_deleted = 0

    </select>

</mapper>